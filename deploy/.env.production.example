# Copy to deploy/.env.production ON THE SERVER and fill in. Never commit or share it.
# Generate each secret with:  openssl rand -base64 32

# Your domain (DNS "A" record must point at this server), e.g. app.example.com
DOMAIN=

# Database password (long random string)
POSTGRES_PASSWORD=

# Sign-in session secret (long random string)
BETTER_AUTH_SECRET=

# Encrypts each restaurant's MTN / Airtel API keys (exactly 32 bytes, base64):
#   openssl rand -base64 32
PAYMENT_SECRETS_KEY=

# Optional: secret for GET /api/cron/payments if you add an external scheduler
CRON_SECRET=

# Optional: brand name shown in the app
BRAND_NAME=Zawli
