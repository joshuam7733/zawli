# Copy to `.env` and adjust. NEVER commit `.env`.

# ── Database ──────────────────────────────────────────────
# `npm run db:local` starts PostgreSQL on port 54329 with these credentials
# (development only). With Docker Compose the port is 5432.
DATABASE_URL="postgresql://zawli:zawli_dev_password@localhost:54329/zawli"
# Used by the integration/security test suite. It is wiped and re-migrated by tests.
TEST_DATABASE_URL="postgresql://zawli:zawli_dev_password@localhost:54329/zawli_test"

# ── Authentication ────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET="replace-with-a-long-random-string"
# Public origin of the app (used for auth callbacks and QR code links)
BETTER_AUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# ── Mobile money (MTN MoMo / Airtel Money) ────────────────
# Encrypts each restaurant's provider API keys at rest. REQUIRED in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# (In development, a key is derived from BETTER_AUTH_SECRET if this is empty.)
PAYMENT_SECRETS_KEY=""
# Optional: lets an external scheduler call GET /api/cron/payments (Bearer token).
# The app already re-checks payments every 20 s in-process.
CRON_SECRET=""

# ── Branding ──────────────────────────────────────────────
# Provisional brand name; change here if name clearance requires it.
NEXT_PUBLIC_BRAND_NAME="Zawli"

# ── Platform bootstrap ────────────────────────────────────
# Used ONCE by `npm run admin:create` to create the first SUPER_ADMIN in a
# non-development environment. The password is not stored anywhere else.
# BOOTSTRAP_ADMIN_EMAIL=""
# BOOTSTRAP_ADMIN_NAME=""

# ── Local PostgreSQL helper (npm run db:local) ────────────
LOCAL_PG_PORT=54329
LOCAL_PG_USER=zawli
LOCAL_PG_PASSWORD=zawli_dev_password
